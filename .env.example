# Password fissa per accedere all'app
APP_PASSWORD=cambia-questa-password

# Secret usato per firmare (HMAC-SHA256) il cookie di sessione.
# Genera un valore casuale lungo, es: openssl rand -base64 32
COOKIE_SECRET=cambia-questo-secret-lungo-e-casuale

# Giorni di validita' del cookie di sessione dopo il login
COOKIE_EXPIRY_DAYS=30

# Supabase - Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key: usata SOLO lato server (API routes), mai esposta al client
SUPABASE_SERVICE_ROLE_KEY=

# Nome del bucket Supabase Storage (pubblico) usato per le foto degli oggetti
SUPABASE_STORAGE_BUCKET=foto-oggetti
